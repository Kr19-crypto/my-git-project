{
  "name": "agent-review-roundtable",
  "version": "0.2.0-beta.0",
  "description": "Open-source multi-agent roundtable code review engine (CLI-first).",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./sdk": "./dist/index.js",
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "review": "tsx src/cli.ts review",
    "mock": "tsx src/cli.ts mock",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "review:built": "node dist/cli.js review",
    "mock:built": "node dist/cli.js mock",
    "test": "node --test --test-isolation=none test/actions.test.mjs test/budget.test.mjs test/report.test.mjs test/env.test.mjs test/config.test.mjs test/context.test.mjs test/paths.test.mjs test/llm.test.mjs test/roundtable.test.mjs test/integration/cli.test.mjs test/diff-directory.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-isolation=none test/actions.test.mjs test/budget.test.mjs test/report.test.mjs test/env.test.mjs test/config.test.mjs test/context.test.mjs test/paths.test.mjs test/llm.test.mjs test/roundtable.test.mjs test/integration/cli.test.mjs test/diff-directory.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:plugin": "node scripts/check-plugin.mjs",
    "precommit:plugin": "node scripts/check-plugin.mjs --static-only"
  },
  "keywords": [
    "dsh",
    "agent",
    "multi-agent",
    "code-review",
    "roundtable",
    "hackathon"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "files": [
    "dist",
    "dsh",
    "cordis.patch.yml",
    "README.md",
    "PROTOCOL.md",
    "LICENSE",
    "config",
    "web"
  ]
}
